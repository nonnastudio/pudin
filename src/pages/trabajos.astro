---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import HandIcon from '../components/HandIcon.astro';

const categories = ['FOOD', 'EVENTOS', 'PRODUCT', 'SOCIAL'];

const baseProjects = [
  {
    title: "Campaña Seagram's",
    category: "FOOD",
    img: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80",
    mediaType: "video",
    mediaUrls: ["https://assets.mixkit.co/videos/preview/mixkit-pouring-a-drink-into-a-glass-with-ice-42311-large.mp4"]
  },
  {
    title: "Les Gigots Launch",
    category: "SOCIAL",
    img: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=80",
    mediaType: "gallery",
    mediaUrls: [
      "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=600&q=80"
    ]
  },
  {
    title: "Beefeater Experience",
    category: "PRODUCT",
    img: "https://images.unsplash.com/photo-1527661591475-527312dd65f5?auto=format&fit=crop&w=600&q=80",
    mediaType: "video",
    mediaUrls: ["https://assets.mixkit.co/videos/preview/mixkit-chef-preparing-a-fresh-vegetable-salad-41584-large.mp4"]
  },
  {
    title: "Narrativas Urbanas",
    category: "SOCIAL",
    img: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=80",
    mediaType: "gallery",
    mediaUrls: [
      "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&w=600&q=80",
      "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=600&q=80"
    ]
  },
  {
    title: "Entrevistas de Calle",
    category: "EVENTOS",
    img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80",
    mediaType: "video",
    mediaUrls: ["https://assets.mixkit.co/videos/preview/mixkit-video-editing-studio-setup-41712-large.mp4"]
  }
];

// Repeat 5 times to form a 5x5 grid (25 items) matching the design screenshot
const projects = Array.from({ length: 5 }).flatMap((_, i) => 
  baseProjects.map((p, idx) => ({
    ...p,
    id: i * 5 + idx + 1
  }))
);
---

<Layout 
  title="Trabajos - Pudin Production Studio"
  description="Portfolio de Pudin: Food, Eventos, Product y Social. Producción de contenido viral."
>
  <!-- Page Header -->
  <section class="w-full px-6 md:px-12 py-8 max-w-7xl mx-auto text-center">
    <h1 class="text-7xl sm:text-9xl md:text-[10rem] font-bold tracking-tighter leading-none uppercase select-none">
      TRABAJOS
    </h1>
  </section>

  <!-- Category Filter -->
  <div class="sticky top-0 z-40 bg-[#fbf9f4] border-b-2 border-black py-4 px-6 md:px-12">
    <div class="max-w-7xl mx-auto flex justify-center gap-6 sm:gap-12 md:gap-20">
      {categories.map((cat) => (
        <button
          data-category={cat}
          class="category-btn text-xs sm:text-sm font-heading font-bold uppercase tracking-widest transition-all duration-200 cursor-pointer pb-1 text-neutral-400 hover:text-black border-b-2 border-transparent hover:border-neutral-400"
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Project Grid -->
  <section class="w-full px-6 md:px-12 py-12 max-w-7xl mx-auto">
    <div id="projects-grid" class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-5">
      {projects.map((proj) => (
        <div
          data-category={proj.category}
          data-id={proj.id}
          data-title={proj.title}
          data-media-type={proj.mediaType}
          data-media-urls={proj.mediaUrls.join(',')}
          class="project-card group relative aspect-[3/4] overflow-hidden bg-black rounded-md cursor-pointer shadow-sm hover:shadow-xl transition-all duration-300 border border-black hover:border-brand-orange"
        >
          <!-- Card Image Fallback -->
          <img 
            src={proj.img} 
            alt={proj.title} 
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 card-image"
            loading="lazy"
          />

          <!-- Hover-Play Video Preview (for Video projects) -->
          {proj.mediaType === 'video' && (
            <video 
              src={proj.mediaUrls[0]} 
              muted 
              loop 
              playsinline 
              class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300 card-video pointer-events-none"
            />
          )}

          <!-- Touch Device indicators / Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-70 group-hover:opacity-90 transition-opacity duration-300"></div>
          
          <!-- Title & Category Info -->
          <div class="absolute bottom-0 left-0 right-0 p-3 md:p-4 translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
            <span class="inline-block text-[9px] md:text-xs font-bold bg-brand-orange text-black px-2 py-0.5 rounded mb-1 uppercase tracking-wide">
              {proj.category}
            </span>
            <h3 class="text-xs md:text-sm font-heading font-black text-[#fbf9f4] leading-tight">
              {proj.title}
            </h3>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Project Detail Modal -->
  <div 
    id="project-modal" 
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden justify-center items-center p-4 transition-all duration-300"
  >
    <!-- Close Button -->
    <button 
      id="modal-close" 
      class="absolute top-6 right-6 z-50 text-white hover:text-brand-orange text-3xl font-display font-bold cursor-pointer select-none focus:outline-none"
    >
      CERRAR
    </button>

    <!-- Side Navigation Arrows -->
    <button 
      id="modal-prev" 
      class="absolute left-4 top-1/2 -translate-y-1/2 z-50 text-white hover:text-brand-orange text-5xl font-bold cursor-pointer select-none focus:outline-none"
    >
      ←
    </button>
    <button 
      id="modal-next" 
      class="absolute right-4 top-1/2 -translate-y-1/2 z-50 text-white hover:text-brand-orange text-5xl font-bold cursor-pointer select-none focus:outline-none"
    >
      →
    </button>

    <!-- Scroll indication hands (Layout 2: Gallery) -->
    <div id="modal-scroll-hands" class="hidden">
      <!-- Left side sticky bounce hand -->
      <div class="fixed left-6 md:left-[10%] top-1/2 -translate-y-1/2 flex flex-col items-center gap-2 pointer-events-none select-none text-[#fbf9f4] font-heading font-bold text-[9px] tracking-widest uppercase">
        <span class="writing-mode-vertical">SCROLL</span>
        <HandIcon direction="down" className="w-8 h-8 text-brand-orange animate-bounce mt-1" />
      </div>
      <!-- Right side sticky bounce hand -->
      <div class="fixed right-6 md:right-[10%] top-1/2 -translate-y-1/2 flex flex-col items-center gap-2 pointer-events-none select-none text-[#fbf9f4] font-heading font-bold text-[9px] tracking-widest uppercase">
        <span class="writing-mode-vertical">SCROLL</span>
        <HandIcon direction="down" className="w-8 h-8 text-brand-orange animate-bounce mt-1" />
      </div>
    </div>

    <!-- Modal Content Scroll Area -->
    <div 
      id="modal-content" 
      class="w-full max-w-4xl h-[85vh] overflow-y-auto flex flex-col items-center justify-start py-12 px-6 scroll-smooth"
    >
      <!-- Centered title/cat -->
      <div class="text-center mb-8">
        <span id="modal-project-cat" class="inline-block text-[10px] font-bold bg-brand-orange text-black px-3 py-1 rounded mb-2 uppercase tracking-wide"></span>
        <h2 id="modal-project-title" class="text-4xl md:text-6xl font-bold text-white uppercase tracking-tight"></h2>
      </div>

      <!-- Media Items wrapper -->
      <div id="modal-media-container" class="w-full max-w-md flex flex-col items-center gap-8">
        <!-- Rendered elements go here -->
      </div>
    </div>
  </div>

  <!-- Client Logos -->
  <Marquee />
</Layout>

<style is:global>
  /* Vertical text for scroll hands */
  .writing-mode-vertical {
    writing-mode: vertical-lr;
    text-orientation: mixed;
  }

  /* Touch Device Support for preview play and persistent text overlay */
  .is-touch .project-card .card-image {
    filter: grayscale(0) !important;
  }
  .is-touch .project-card .card-video {
    opacity: 1 !important;
  }
  .is-touch .project-card div[class*="translate-y-1"] {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  /* Custom scrollbar inside modal to be clean and minimal */
  #modal-content::-webkit-scrollbar {
    width: 6px;
  }
  #modal-content::-webkit-scrollbar-track {
    background: transparent;
  }
  #modal-content::-webkit-scrollbar-thumb {
    background: #ea460a;
    border-radius: 3px;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('.category-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  // Detect touch capability to force autoplay and remove grayscale on mobile devices
  const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  if (isTouchDevice) {
    document.body.classList.add('is-touch');
  }

  // Hover-play previews on desktop, autoplay on mobile
  cards.forEach(card => {
    const video = card.querySelector<HTMLVideoElement>('video');
    if (video) {
      if (isTouchDevice) {
        // Autoplay on load for mobile/tablets
        video.play().catch(() => {});
      } else {
        // Trigger play on hover for desktop
        card.addEventListener('mouseenter', () => {
          video.play().catch(() => {});
        });
        card.addEventListener('mouseleave', () => {
          video.pause();
          video.currentTime = 0;
        });
      }
    }
  });

  // Filter project cards logic
  const filterProjects = (category: string) => {
    cards.forEach(card => {
      const cardCat = card.dataset.category || '';
      if (category === 'ALL' || cardCat === category) {
        card.style.display = 'block';
        setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'scale(1)'; }, 10);
      } else {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(() => { card.style.display = 'none'; }, 200);
      }
    });
  };

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.category || '';
      const isAlreadyActive = btn.classList.contains('active-cat');

      buttons.forEach(b => {
        b.classList.remove('border-black', 'text-black', 'active-cat');
        b.classList.add('text-neutral-400', 'border-transparent');
      });

      if (isAlreadyActive) {
        filterProjects('ALL');
      } else {
        btn.classList.add('border-black', 'text-black', 'active-cat');
        btn.classList.remove('text-neutral-400', 'border-transparent');
        filterProjects(selected);
      }
    });
  });

  // Modal Functionality
  const modal = document.getElementById('project-modal') as HTMLElement;
  const modalClose = document.getElementById('modal-close') as HTMLElement;
  const modalPrev = document.getElementById('modal-prev') as HTMLElement;
  const modalNext = document.getElementById('modal-next') as HTMLElement;
  const modalContent = document.getElementById('modal-content') as HTMLElement;
  const modalTitle = document.getElementById('modal-project-title') as HTMLElement;
  const modalCat = document.getElementById('modal-project-cat') as HTMLElement;
  const modalMediaContainer = document.getElementById('modal-media-container') as HTMLElement;
  const scrollHands = document.getElementById('modal-scroll-hands') as HTMLElement;

  let currentProjectList: any[] = [];
  let currentActiveIndex = 0;

  // Build the list of active/visible projects dynamically from the cards
  const rebuildProjectList = () => {
    const visibleCards = Array.from(cards).filter(c => c.style.display !== 'none');
    currentProjectList = visibleCards.map(c => {
      const el = c as HTMLElement;
      return {
        id: el.dataset.id,
        title: el.dataset.title,
        category: el.dataset.category,
        mediaType: el.dataset.mediaType,
        mediaUrls: el.dataset.mediaUrls ? el.dataset.mediaUrls.split(',') : []
      };
    });
  };

  const openModal = (cardElement: HTMLElement) => {
    rebuildProjectList();
    const cardId = cardElement.dataset.id;
    currentActiveIndex = currentProjectList.findIndex(p => p.id === cardId);
    
    if (currentActiveIndex === -1) {
      // Fallback in case list is out of sync
      rebuildProjectList();
      currentActiveIndex = currentProjectList.findIndex(p => p.id === cardId);
      if (currentActiveIndex === -1) return;
    }

    renderModalContent();
  };

  const renderModalContent = () => {
    const project = currentProjectList[currentActiveIndex];
    if (!project) return;

    modalTitle.textContent = project.title;
    modalCat.textContent = project.category;
    
    modalMediaContainer.innerHTML = '';
    modalContent.scrollTop = 0;

    if (project.mediaType === 'video') {
      scrollHands.classList.add('hidden');
      
      const video = document.createElement('video');
      video.src = project.mediaUrls[0];
      video.autoplay = true;
      video.loop = true;
      video.controls = true;
      video.playsInline = true;
      video.className = "w-full aspect-[9/16] object-cover rounded-lg shadow-2xl border-2 border-neutral-900";
      modalMediaContainer.appendChild(video);
    } else {
      // Gallery with multiple photos
      scrollHands.classList.remove('hidden');
      
      project.mediaUrls.forEach((url: string, idx: number) => {
        if (url.endsWith('.mp4')) {
          const video = document.createElement('video');
          video.src = url;
          video.autoplay = true;
          video.loop = true;
          video.controls = true;
          video.playsInline = true;
          video.className = "w-full aspect-[9/16] object-cover rounded-lg shadow-xl border border-neutral-900";
          modalMediaContainer.appendChild(video);
        } else {
          const img = document.createElement('img');
          img.src = url;
          img.alt = `${project.title} media ${idx}`;
          img.className = "w-full aspect-[9/16] object-cover rounded-lg shadow-xl border border-neutral-900";
          modalMediaContainer.appendChild(img);
        }
      });
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    // Set URL hash to allow sharing / deep linking
    window.location.hash = `project-${project.id}`;
  };

  const closeModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modalMediaContainer.innerHTML = '';
    document.body.style.overflow = '';
    
    // Clean up URL hash without reloading page
    history.replaceState(null, '', window.location.pathname + window.location.search);
  };

  // Add click events to all project cards
  cards.forEach(card => {
    card.addEventListener('click', () => {
      openModal(card as HTMLElement);
    });
  });

  modalClose.addEventListener('click', closeModal);

  modalPrev.addEventListener('click', () => {
    if (currentProjectList.length === 0) rebuildProjectList();
    currentActiveIndex = (currentActiveIndex - 1 + currentProjectList.length) % currentProjectList.length;
    renderModalContent();
  });

  modalNext.addEventListener('click', () => {
    if (currentProjectList.length === 0) rebuildProjectList();
    currentActiveIndex = (currentActiveIndex + 1) % currentProjectList.length;
    renderModalContent();
  });

  // Close modal when clicking outside content area
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') modalPrev.click();
    if (e.key === 'ArrowRight') modalNext.click();
  });

  // Handle Hash parameters (both category selection or deep-linking to project detail view)
  const handleHash = () => {
    const hash = window.location.hash.slice(1);
    if (hash) {
      if (hash.startsWith('project-')) {
        const projectId = hash.replace('project-', '');
        const targetCard = Array.from(cards).find(c => (c as HTMLElement).dataset.id === projectId);
        if (targetCard) {
          // Open target card modal
          openModal(targetCard as HTMLElement);
        }
      } else {
        const cat = hash.toUpperCase();
        const targetBtn = Array.from(buttons).find(b => b.dataset.category === cat);
        if (targetBtn) {
          targetBtn.click();
          document.querySelector('.sticky')?.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }
  };

  window.addEventListener('load', handleHash);
  window.addEventListener('hashchange', handleHash);
</script>
