---

<Layout 
  title="Trabajos - Pudin Production Studio"
  description="Portfolio de Pudin: Food, Eventos, Product y Social. Producción de contenido viral."
>
  <!-- Page Header -->
  <section class="w-full px-6 md:px-12 py-8 max-w-7xl mx-auto">
    <h1 class="text-7xl sm:text-9xl md:text-[10rem] font-bold tracking-tighter leading-none uppercase">
      TRABAJOS
    </h1>
  </section>

  <!-- Category Filter -->
  <div class="sticky top-0 z-40 bg-[#fbf9f4] border-b-2 border-black py-4 px-6 md:px-12">
    <div class="max-w-7xl mx-auto flex justify-center gap-4 sm:gap-10 md:gap-16">
      {categories.map((cat) => (
        <button
          data-category={cat}
          class:list={[
            "category-btn text-xs sm:text-sm font-heading font-bold uppercase tracking-widest transition-all duration-200 cursor-pointer pb-1",
            cat === 'TODOS'
              ? "border-b-2 border-black text-black active-cat"
              : "text-neutral-400 hover:text-black border-b-2 border-transparent hover:border-neutral-400"
          ]}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Project Grid -->
  <section class="w-full px-6 md:px-12 py-12 max-w-7xl mx-auto">
    <div id="projects-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-5">
      {projects.map((proj) => (
        <div
          data-category={proj.category}
          class="project-card group relative aspect-[3/4] overflow-hidden bg-black rounded-md cursor-pointer shadow-sm hover:shadow-xl transition-all duration-500 border border-black hover:border-brand-orange"
        >
          <img 
            src={proj.img} 
            alt={proj.title} 
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500"
            loading="lazy"
          />
          <!-- Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-70 group-hover:opacity-90 transition-opacity duration-300"></div>
          
          <!-- Info -->
          <div class="absolute bottom-0 left-0 right-0 p-3 md:p-4 translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
            <span class="inline-block text-[9px] md:text-xs font-bold bg-brand-orange text-black px-2 py-0.5 rounded mb-1 uppercase tracking-wide">
              {proj.category}
            </span>
            <h3 class="text-xs md:text-sm font-heading font-black text-[#fbf9f4] leading-tight">
              {proj.title}
            </h3>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Client Logos -->
  <Marquee />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('.category-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.category || 'TODOS';

      // Update active state
      buttons.forEach(b => {
        b.classList.remove('border-black', 'text-black', 'active-cat');
        b.classList.add('text-neutral-400', 'border-transparent');
      });
      btn.classList.add('border-black', 'text-black', 'active-cat');
      btn.classList.remove('text-neutral-400', 'border-transparent');

      // Show/hide cards
      cards.forEach(card => {
        if (selected === 'TODOS' || card.dataset.category === selected) {
          card.style.display = 'block';
          setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'scale(1)'; }, 10);
        } else {
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => { card.style.display = 'none'; }, 300);
        }
      });
    });
  });
</script>
