---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const logos = [
  { name: "Beefeater",      file: "beefeater.svg"    },
  { name: "Google",         file: "google.svg"        },
  { name: "Jameson",        file: "jameson.svg"       },
  { name: "Johnnie Walker", file: "johnnie-walker.svg"},
  { name: "LQDVI",          file: "lqdvi.svg"         },
  { name: "Seagram's Gin",  file: "seagrams-gin.svg"  },
  { name: "YouTube",        file: "youtube.svg"       },
];
---

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
  }
  .marquee-track-fwd {
    animation: marquee-fwd 28s linear infinite;
  }
  .marquee-track-rev {
    animation: marquee-rev 28s linear infinite;
  }
  .marquee-track-fwd:hover,
  .marquee-track-rev:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-fwd {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marquee-rev {
    0%   { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  .logo-item {
    flex-shrink: 0;
    padding: 0 3rem;
  }
  .logo-item img {
    height: 2.5rem;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: block;
  }
  @media (min-width: 768px) {
    .logo-item img {
      height: 3rem;
      max-width: 180px;
    }
    .logo-item {
      padding: 0 4rem;
    }
  }
</style>

<div class="relative w-full overflow-hidden bg-transparent py-12 flex flex-col gap-8 my-12 border-y border-neutral-200/50">
  <!-- Row 1: left → right -->
  <div class="w-full overflow-hidden">
    <div class="marquee-track marquee-track-rev">
      {/* Render logos twice for seamless loop */}
      {[...logos, ...logos].map((logo, i) => (
        <div class="logo-item">
          <img
            src={`${base}logos/${logo.file}`}
            alt={logo.name}
            class="opacity-50 hover:opacity-100 transition-all duration-300 grayscale hover:grayscale-0"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2: right → left -->
  <div class="w-full overflow-hidden">
    <div class="marquee-track marquee-track-fwd">
      {[...[...logos].reverse(), ...[...logos].reverse()].map((logo, i) => (
        <div class="logo-item">
          <img
            src={`${base}logos/${logo.file}`}
            alt={logo.name}
            class="opacity-50 hover:opacity-100 transition-all duration-300 grayscale hover:grayscale-0"
          />
        </div>
      ))}
    </div>
  </div>
</div>
