---
import { Image } from 'astro:assets';
import handImg from '../assets/hand.png';

interface Props {
  direction?: 'up' | 'down' | 'left' | 'right';
  className?: string;
  size?: number;
}

const { direction = 'down', className = "h-8 w-8", size = 32 } = Astro.props;

// Rotation mapping
// The original hand.png pixel art image points UP.
const rotation = {
  up: 'rotate-0',
  down: 'rotate-180',
  left: 'rotate-270',
  right: 'rotate-90',
};

const rotateClass = rotation[direction] || 'rotate-180';
---
<Image 
  src={handImg} 
  alt="Indicador de mano" 
  width={size}
  class={`${className} ${rotateClass} transition-transform duration-200 select-none inline-block object-contain`}
  style="image-rendering: pixelated;"
/>
