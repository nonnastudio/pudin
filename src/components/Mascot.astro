---
interface Props {
  className?: string;
  size?: number;
}

const { className = "h-16 w-16", size = 64 } = Astro.props;
---
<svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 120 120" 
  width={size} 
  height={size} 
  class={`${className} transition-transform duration-300 hover:scale-110 select-none`}
>
  <!-- Drop Shadow -->
  <ellipse cx="60" cy="108" rx="35" ry="8" fill="#e2dcd0" />
  
  <!-- Legs & Boots (Walking pose) -->
  <g stroke="#000000" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <!-- Left Leg (Behind) -->
    <path d="M45,85 L35,100 L25,100" />
    <!-- Left Boot (Orange/Yellow) -->
    <path d="M28,96 C28,96 22,96 18,100 C15,103 18,105 25,105 C32,105 32,96 28,96 Z" fill="#e89d6c" stroke="#000000" stroke-width="4" />
    
    <!-- Right Leg (Forward) -->
    <path d="M75,85 L85,98 L98,96" />
    <!-- Right Boot -->
    <path d="M92,92 C92,92 98,94 102,98 C105,101 101,104 94,103 C87,102 88,94 92,92 Z" fill="#e89d6c" stroke="#000000" stroke-width="4" />
  </g>

  <!-- Pudding Body -->
  <path 
    d="M25,85 C22,60 25,35 30,30 C35,25 85,25 90,30 C95,35 98,60 95,85 C75,90 45,90 25,85 Z" 
    fill="#fcc853" 
    stroke="#000000" 
    stroke-width="5" 
    stroke-linejoin="round"
  />

  <!-- Caramel Melt Top -->
  <path 
    d="M30,30 C33,35 40,38 45,35 C50,32 55,30 60,33 C65,36 70,38 75,34 C80,30 87,28 90,30 C91,32 94,55 93,60 C88,64 84,60 80,62 C76,64 74,68 70,67 C66,66 64,58 60,60 C56,62 52,65 48,63 C44,61 42,54 38,55 C34,56 31,61 27,58 C26,52 29,32 30,30 Z" 
    fill="#b55822" 
    stroke="#000000" 
    stroke-width="4.5" 
    stroke-linejoin="round"
  />

  <!-- Cute Eyes -->
  <g fill="#000000">
    <!-- Left Eye -->
    <circle cx="48" cy="56" r="6" />
    <circle cx="46" cy="54" r="2" fill="#ffffff" />
    <!-- Right Eye -->
    <circle cx="72" cy="56" r="6" />
    <circle cx="70" cy="54" r="2" fill="#ffffff" />
  </g>

  <!-- Blushing Cheeks -->
  <g fill="#ff8ba7" opacity="0.6">
    <ellipse cx="40" cy="62" rx="5" ry="3" />
    <ellipse cx="80" cy="62" rx="5" ry="3" />
  </g>

  <!-- Happy Mouth -->
  <path 
    d="M56,64 Q60,68 64,64" 
    stroke="#000000" 
    stroke-width="4.5" 
    stroke-linecap="round" 
    fill="none" 
  />
</svg>
