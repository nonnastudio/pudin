---
interface Props {
  className?: string;
  size?: number;
}

const { className = "h-16 w-16", size = 64 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<img
  src={`${base}pudino.gif`}
  alt="Pudin mascot"
  width={size}
  height={size}
  class={`${className} transition-transform duration-300 hover:scale-110 select-none object-contain`}
  draggable="false"
/>
